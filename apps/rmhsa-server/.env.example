# MongoDB connection string (same database the legacy Express server used).
MONGO_URI=

# Secret used to sign admin JWT tokens.
JWT_SECRET=

# Resend API key used for contact form email submissions.
RESEND_API_KEY=

# Gmail credentials for Nodemailer (blog & notification alerts to subscribers).
GMAIL_USER=
GMAIL_PASS=

# Optional HTTP port (defaults to 3000).
PORT=8080
