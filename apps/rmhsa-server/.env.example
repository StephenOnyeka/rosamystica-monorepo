# PostgreSQL connection string for Supabase / PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend URL(s) for CORS allowed origins (comma-separated if multiple)
FRONTEND_URL=https://www.rmhsagulu.com,https://rmhsagulu.com

# Secret used to sign admin JWT tokens.
JWT_SECRET=your_jwt_secret_here

# Resend API key used for contact form email submissions.
RESEND_API_KEY=re_your_api_key

# Gmail credentials for Nodemailer (blog & notification alerts to subscribers).
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password

# Optional HTTP port (defaults to 8080).
PORT=8080
