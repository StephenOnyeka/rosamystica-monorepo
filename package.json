{
  "name": "rosamystica-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ui": "turbo run dev --filter=rmhsa-ui",
    "dev:server": "turbo run dev --filter=rmhsa-server",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
